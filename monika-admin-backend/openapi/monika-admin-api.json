  "components": {
    "schemas": {
      "MergeResult": {
        "type": "object",
        "properties": {
          "added": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "updated": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "description": "Egy import eredménye: hány elem lett új, és hány frissült egy meglévő helyén."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SegmentDto": {
        "required": [
          "topics",
          "title",
          "videoId",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "topics": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "maxLength": 80,
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "videoId": {
            "maxLength": 260,
            "type": "string"
          },
          "timestamp": {
            "pattern": "^(\\d+:[0-5]\\d|\\d+:[0-5]\\d:[0-5]\\d)$",
            "type": "string",
            "description": "Kezdőidő `mm:ss` vagy `h:mm:ss` formában."
          }
        }
      },
      "SegmentVmList": {
        "required": [
          "topics",
          "keywords",
          "title",
          "description",
          "videoId",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "videoId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "VideoDto": {
        "required": [
          "videoId"
        ],
        "type": "object",
        "properties": {
          "videoId": {
            "maxLength": 260,
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "type": "string"
          },
          "url": {
            "maxLength": 2048,
            "type": "string"
          },
          "duration": {
            "pattern": "^(\\d+:[0-5]\\d|\\d+:[0-5]\\d:[0-5]\\d)$",
            "type": [
              "null",
              "string"
            ],
            "description": "Hossz `mm:ss` vagy `h:mm:ss` formában; üres, ha nem ismert."
          }
        }
      },
      "VideoVmList": {
        "required": [
          "videoId",
          "title",
          "url"
        ],
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string"
          },
